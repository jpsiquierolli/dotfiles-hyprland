;; --- ROOT ---
(include "./panel/panel.yuck")

;; --- BAR ---
(defwindow window_bar
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "0.5%"
                      :width "70%"
                      :height "0px"
                      :anchor "top center")
  :stacking "fg"
  :windowtype "dock"
  :exclusive true
  :wm-ignore false
  :namespace "eww-bar"
  (widget_bar))

;; --- PANEL ---
(defwindow window_panel
  :monitor 0
  :geometry (geometry :x "20px"
                      :y "20px"
                      :width "420px"
                      :height "380px"
                      :anchor "top right")
  :stacking "fg"
  :namespace "eww-panel"
  (widget_panel))

;; --- BACKGROUND CLOSER ---
(defwindow background_closer
  :monitor 0
  :geometry (geometry :width "100%" :height "100%")
  :stacking "fg"
  :focusable false
  (eventbox :onclick "eww close window_panel background_closer"))
